<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; }
    .container { padding: 1rem; }
    .header { text-align: center; padding: 1rem; background-color: #f4f4f4; }
    .header img { width: 100px; height: 100px; border-radius: 50%; }
    .content { padding: 1rem; }
    .content h3 { border-bottom: 1px solid #eee; padding-bottom: 0.5rem; }
  </style>
</head>
<body>
  <div class="header">
    <img src="https://twoemcyberkagwe.onrender.com/logo.jpg" alt="Twoem Online Productions">
    <h2>New Contact Form Submission</h2>
  </div>
  <div class="content">
    <h3>Contact Details</h3>
    <ul>
      <li><strong>Name:</strong> <%= name %></li>
      <li><strong>Email:</strong> <%= email %></li>
      <li><strong>Phone:</strong> <%= phone || 'Not provided' %></li>
    </ul>
    <h3>Message</h3>
    <p><%= message %></p>
  </div>
</body>
</html>
