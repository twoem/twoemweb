<%- include('partials/header') %>

<main class="container">
  <h1>Downloads</h1>

  <% if (status === 'success') { %>
    <div class="success-message">
      <p>Your download will start shortly.</p>
    </div>
  <% } %>

  <section class="public-documents">
    <h2>Public Documents</h2>
    <ul>
      <li><a href="/download?file=public/document1.pdf">Document 1</a></li>
      <li><a href="/download?file=public/document2.pdf">Document 2</a></li>
    </ul>
  </section>

  <section class="eulogy-documents">
    <h2>Eulogy Documents</h2>
    <ul>
      <li>
        <a href="/download?file=eulogies/eulogy1.pdf">Eulogy for John Doe</a>
        <span>Expires in 5 days</span>
      </li>
      <li>
        <a href="/download?file=eulogies/eulogy2.pdf">Eulogy for Jane Doe</a>
        <span>Expires in 2 days</span>
      </li>
    </ul>
  </section>
</main>

<%- include('partials/footer') %>
