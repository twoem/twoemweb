<%- include('partials/header') %>

<main>
  <section class="hero">
    <div class="container">
      <h1>Twoem Online Productions</h1>
      <p>Your one-stop shop for all your digital and printing needs.</p>
      <a href="/contact" class="cta-button">Get in Touch</a>
    </div>
  </section>

  <section class="container">
    <div class="about-teaser">
      <div class="about-image">
        <img src="/images/about-us.jpg" alt="About Us">
      </div>
      <div class="about-text">
        <h2>About Us</h2>
        <p>We are a team of passionate professionals dedicated to providing high-quality services to our clients. We specialize in digital and printing solutions, computer education, and government services.</p>
      </div>
    </div>

    <div class="services-snapshot">
      <h2>Our Services</h2>
      <div class="service-cards">
        <div class="card">
          <h3>Digital & Printing Solutions</h3>
          <p>High-quality printing, binding, and design services.</p>
        </div>
        <div class="card">
          <h3>Computer Education</h3>
          <p>Courses and certifications to enhance your IT skills.</p>
        </div>
        <div class="card">
          <h3>Government Services</h3>
          <p>Assistance with eCitizen, NHIF/NSSF, KRA, and passport applications.</p>
        </div>
      </div>
    </div>

    <div class="testimonials">
      <h2>What Our Clients Say</h2>
      <div class="testimonial-cards">
        <div class="card">
          <div class="testimonial-author">
            <img src="/images/testimonials/jane-smith.jpg" alt="Jane Smith">
            <div>
              <h3>Jane Smith</h3>
              <p>CEO, Smith & Co.</p>
            </div>
          </div>
          <p>"Twoem Online Productions delivered a high-quality website for my business. I'm very happy with the result."</p>
        </div>
        <div class="card">
          <div class="testimonial-author">
            <img src="/images/testimonials/mark-johnson.jpg" alt="Mark Johnson">
            <div>
              <h3>Mark Johnson</h3>
              <p>Marketing Manager, ABC Corp</p>
            </div>
          </div>
          <p>"The team at Twoem is professional, and they always go the extra mile to ensure customer satisfaction."</p>
        </div>
        <div class="card">
          <div class="testimonial-author">
            <img src="/images/testimonials/sarah-lee.jpg" alt="Sarah Lee">
            <div>
              <h3>Sarah Lee</h3>
              <p>Freelance Designer</p>
            </div>
          </div>
          <p>"I highly recommend Twoem for all your printing and design needs. They are the best in town!"</p>
        </div>
      </div>
    </div>

    <div class="location-hours">
      <h2>Location & Hours</h2>
      <div class="map">
        <iframe src="<%= process.env.GOOGLE_MAP_URL %>" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
      </div>
      <div class="info">
        <p>Kagwe Town, Plaza Building Opposite Total Petrol Station</p>
        <p>Monday - Friday: 9am - 5pm</p>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
