<%- include('partials/header') %>

<main>
  <section class="hero">
    <h1>Twoem Online Productions</h1>
    <p>Your one-stop shop for all your digital and printing needs.</p>
    <a href="/contact" class="cta-button">Get in Touch</a>
  </section>

  <section class="about-teaser">
    <div class="about-image">
      <img src="/images/about-us.jpg" alt="About Us">
    </div>
    <div class="about-text">
      <h2>About Us</h2>
      <p>We are a team of passionate professionals dedicated to providing high-quality services to our clients. We specialize in digital and printing solutions, computer education, and government services.</p>
    </div>
  </section>

  <section class="services-snapshot">
    <h2>Our Services</h2>
    <div class="service-cards">
      <div class="card">
        <h3>Digital & Printing Solutions</h3>
        <p>High-quality printing, binding, and design services.</p>
      </div>
      <div class="card">
        <h3>Computer Education</h3>
        <p>Courses and certifications to enhance your IT skills.</p>
      </div>
      <div class="card">
        <h3>Government Services</h3>
        <p>Assistance with eCitizen, NHIF/NSSF, KRA, and passport applications.</p>
      </div>
    </div>
  </section>

  <section class="stats-testimonials">
    <div class="stats">
      <div class="stat">
        <h3>100+</h3>
        <p>Happy Clients</p>
      </div>
      <div class="stat">
        <h3>500+</h3>
        <p>Projects Completed</p>
      </div>
      <div class="stat">
        <h3>10+</h3>
        <p>Years of Experience</p>
      </div>
    </div>
    <div class="testimonials">
      <h2>Testimonials</h2>
      <div class="testimonial">
        <p>"Twoem Online Productions is the best! They are professional, reliable, and affordable."</p>
        <cite>- John Doe</cite>
      </div>
    </div>
  </section>

  <section class="feature-highlights">
    <h2>Feature Highlights</h2>
    <ul>
      <li>Fast and reliable service</li>
      <li>Affordable prices</li>
      <li>Experienced and professional team</li>
    </ul>
  </section>

  <section class="latest-news">
    <h2>Latest News</h2>
    <div class="news-articles">
      <div class="article">
        <h3>New Service Launch</h3>
        <p>We are excited to announce the launch of our new web design service.</p>
        <a href="#">Read More</a>
      </div>
      <div class="article">
        <h3>Partnership with XYZ Company</h3>
        <p>We have partnered with XYZ Company to provide our clients with a wider range of services.</p>
        <a href="#">Read More</a>
      </div>
    </div>
  </section>

  <section class="location-hours">
    <h2>Location & Hours</h2>
    <div class="map">
      <iframe src="<%= process.env.GOOGLE_MAP_URL %>" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
    </div>
    <div class="info">
      <p>123 Main Street, Anytown, CA 12345</p>
      <p>Monday - Friday: 9am - 5pm</p>
    </div>
  </section>

  <section class="newsletter-signup">
    <h2>Newsletter Signup</h2>
    <form action="/newsletter-signup" method="post">
      <input type="email" name="email" placeholder="Enter your email">
      <button type="submit">Subscribe</button>
    </form>
  </section>
</main>

<%- include('partials/footer') %>
